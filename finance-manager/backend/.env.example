# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Leaves fallback to in-memory MongoDB if local MongoDB is unavailable)
MONGO_URI=mongodb://127.0.0.1:27017/financemanager

# JWT Authentication Secret (Replace with a strong random secret in production)
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRE=30d
